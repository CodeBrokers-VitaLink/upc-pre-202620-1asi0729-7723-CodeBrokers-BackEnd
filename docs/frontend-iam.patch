+import { TestBed } from '@angular/core/testing';
+import { HttpClient, provideHttpClient, withInterceptors } from '@angular/common/http';
+import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
+import { authInterceptor } from './auth.interceptor';
+import { TokenStorage } from './token-storage';
+import { environment } from '../../../environments/environment';
+
+describe('Bearer boundary', () => {
+  let http: HttpClient;
+  let requests: HttpTestingController;
+  let tokens: TokenStorage;
+  beforeEach(() => {
+    sessionStorage.clear();
+    TestBed.configureTestingModule({ providers: [provideHttpClient(withInterceptors([authInterceptor])), provideHttpClientTesting()] });
+    http = TestBed.inject(HttpClient); requests = TestBed.inject(HttpTestingController); tokens = TestBed.inject(TokenStorage);
+    tokens.save('test-token', 900);
+  });
+  afterEach(() => { requests.verify(); tokens.clear(); });
+  it('attaches Bearer only to the exact API origin and path boundary', () => {
+    const base = environment.authApiUrl;
+    for (const url of [base + '/auth/me', '/i18n/es.json', 'https://vitallink-fakeapi.onrender.com/patients',
+      'https://example.test/api/v1/auth/me', 'http://localhost.evil.test:8080/api/v1/auth/me',
+      'http://localhost:8080/api/v10/auth/me', base + '/auth/login']) {
+      http.get(url).subscribe();
+      const request = requests.expectOne(url);
+      expect(request.request.headers.get('Authorization')).toBe(url === base + '/auth/me' ? 'Bearer test-token' : null);
+      request.flush({});
+    }
+  });
+  it('keeps the session on 403 and clears it on protected 401', () => {
+    for (const status of [403, 401]) {
+      http.get(environment.authApiUrl + '/auth/me').subscribe({ error: () => {} });
+      requests.expectOne(environment.authApiUrl + '/auth/me').flush({}, { status, statusText: 'Denied' });
+      expect(tokens.token()).toBe(status === 403 ? 'test-token' : null);
+    }
+  });
+  it('does not invalidate a newer session because of an older request', () => {
+    http.get(environment.authApiUrl + '/auth/me').subscribe({ error: () => {} });
+    const old = requests.expectOne(environment.authApiUrl + '/auth/me');
+    tokens.clear(); tokens.save('new-token', 900);
+    old.flush({}, { status: 401, statusText: 'Unauthorized' });
+    expect(tokens.token()).toBe('new-token');
+  });
+  it('does not treat a login rejection as expiration of a protected session', () => {
+    http.post(environment.authApiUrl + '/auth/login', {}).subscribe({ error: () => {} });
+    requests.expectOne(environment.authApiUrl + '/auth/login').flush({}, { status: 401, statusText: 'Unauthorized' });
+    expect(tokens.token()).toBe('test-token');
+  });
+});
