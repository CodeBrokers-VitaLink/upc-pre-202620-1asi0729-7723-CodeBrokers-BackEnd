+import { TestBed } from '@angular/core/testing';
+import { signal } from '@angular/core';
+import { Subject } from 'rxjs';
+import { CareStore } from './care.store';
+import { CareService } from '../infrastructure/care/care.service';
+import { CARE_CONTEXT } from '../infrastructure/care/care-context';
+import { CareSnapshot } from '../domain/model/care.snapshot';
+import { AuthenticationStore } from '../../iam/application/authentication.store';
+import { UserStore } from '../../iam/application/user.store';
+import { TokenStorage } from '../../iam/infrastructure/token-storage';
+import { environment } from '../../../environments/environment';
+
+describe('Care session isolation', () => {
+  const empty: CareSnapshot = { patients: [], alerts: [], records: [], interventions: [], caregivers: [], measurementRanges: [] };
+  let previous = new Subject<CareSnapshot>();
+  let next = new Subject<CareSnapshot>();
+  let calls = 0;
+  const enabled = environment.careEnabled;
+  beforeEach(() => {
+    sessionStorage.clear(); previous = new Subject(); next = new Subject(); calls = 0;
+    TestBed.configureTestingModule({ providers: [
+      { provide: CareService, useValue: { load: () => ++calls === 1 ? previous : next } },
+      { provide: AuthenticationStore, useValue: { hasSession: () => true } },
+      { provide: UserStore, useValue: { user: signal(null) } },
+      { provide: CARE_CONTEXT, useValue: signal({ providerId: null, familyId: null, clinicId: null }) },
+    ] });
+  });
+  afterEach(() => { environment.careEnabled = enabled; TestBed.inject(TokenStorage).clear(); });
+  it('does not request demo clinical data in the IAM increment', () => {
+    environment.careEnabled = false;
+    const store = TestBed.inject(CareStore); store.load();
+    expect(calls).toBe(0); expect(store.error()).toBe('integrationPending');
+  });
+  it('cancels old work, clears state immediately and ignores late responses after another login', () => {
+    environment.careEnabled = true;
+    const store = TestBed.inject(CareStore); const tokens = TestBed.inject(TokenStorage);
+    store.load(); expect(store.loading()).toBe(true);
+    tokens.clear();
+    expect(store.loading()).toBe(false); expect(store.data()).toEqual(empty);
+    store.load();
+    previous.next({ ...empty, measurementRanges: [{} as never] }); previous.complete();
+    expect(store.data()).toEqual(empty); expect(store.loading()).toBe(true); expect(store.lastSync()).toBeNull();
+    next.next(empty); next.complete();
+    expect(store.loading()).toBe(false); expect(store.lastSync()).not.toBeNull();
+    tokens.clear(); expect(store.lastSync()).toBeNull();
+  });
+});
