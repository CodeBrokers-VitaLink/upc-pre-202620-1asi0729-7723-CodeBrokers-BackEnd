diff --git a/src/app/iam/application/authentication.store.spec.ts b/src/app/iam/application/authentication.store.spec.ts
new file mode 100644
index 0000000..958f903
--- /dev/null
+++ b/src/app/iam/application/authentication.store.spec.ts
@@ -0,0 +1,109 @@
+import { TestBed } from '@angular/core/testing';
+import { provideHttpClient, withInterceptors } from '@angular/common/http';
+import { provideHttpClientTesting, HttpTestingController } from '@angular/common/http/testing';
+import { provideRouter, Router } from '@angular/router';
+import { AuthenticationStore } from './authentication.store';
+import { TokenStorage } from '../infrastructure/token-storage';
+import { authInterceptor } from '../infrastructure/auth.interceptor';
+import { environment } from '../../../environments/environment';
+import { UserResponse } from '../infrastructure/user.response';
+import { RoleAssembler } from '../infrastructure/role.assembler';
+import { roleGuard } from '../presentation/guards/role.guard';
+import { ActivatedRouteSnapshot, RouterStateSnapshot } from '@angular/router';
+import { Observable } from 'rxjs';
+
+const doctor: UserResponse = { id: 'account-a', name: 'Doctor', email: 'doctor@example.test', role: 'doctor',
+  careContext: { providerId: 'profile-a', clinicId: 'clinic-a', familyId: null } };
+describe('Validated session', () => {
+  let requests: HttpTestingController;
+  let tokens: TokenStorage;
+  beforeEach(() => {
+    sessionStorage.clear();
+    TestBed.configureTestingModule({ providers: [provideRouter([]), provideHttpClient(withInterceptors([authInterceptor])), provideHttpClientTesting()] });
+    requests = TestBed.inject(HttpTestingController);
+  });
+  afterEach(() => { requests.verify(); tokens?.clear(); });
+  function store() {
+    tokens = TestBed.inject(TokenStorage);
+    return TestBed.inject(AuthenticationStore);
+  }
+  function restored() {
+    sessionStorage.setItem('vitalink-access-token', JSON.stringify({ accessToken: 'stored', expiresAt: Date.now() + 900000 }));
+    return store();
+  }
+  it('posts credentials without transforming the password and accepts server identity', () => {
+    const authentication = store();
+    authentication.signIn(' Doctor@Example.test ', ' exact password ').subscribe();
+    const request = requests.expectOne(environment.authApiUrl + '/auth/login');
+    expect(request.request.method).toBe('POST');
+    expect(request.request.body).toEqual({ email: 'doctor@example.test', password: ' exact password ' });
+    request.flush({ accessToken: 'signed', tokenType: 'Bearer', expiresIn: 900, user: doctor });
+    expect(authentication.session()?.userId).toBe('account-a');
+    expect(authentication.careContext().providerId).toBe('profile-a');
+    expect(sessionStorage.getItem('vitalink-access-token')).not.toContain('password');
+  });
+  it('restores only after /me and the guard waits for that validation', () => {
+    const authentication = restored();
+    expect(authentication.status()).toBe('pending'); expect(authentication.hasSession()).toBe(false);
+    let resolved = false;
+    const route = { data: { role: 'doctor' } } as unknown as ActivatedRouteSnapshot;
+    const result = TestBed.runInInjectionContext(() => roleGuard(route, {} as RouterStateSnapshot));
+    (result as Observable<unknown>).subscribe(value => { expect(value).toBe(true); resolved = true; });
+    expect(resolved).toBe(false);
+    requests.expectOne(environment.authApiUrl + '/auth/me').flush(doctor);
+    expect(resolved).toBe(true); expect(authentication.hasSession()).toBe(true);
+  });
+  it('keeps network failure recoverable without granting access', () => {
+    const authentication = restored();
+    authentication.ensureValidated().subscribe();
+    requests.expectOne(environment.authApiUrl + '/auth/me').error(new ProgressEvent('network'));
+    expect(authentication.status()).toBe('unavailable'); expect(authentication.hasSession()).toBe(false);
+    expect(tokens.token()).toBe('stored');
+    authentication.ensureValidated().subscribe();
+    requests.expectOne(environment.authApiUrl + '/auth/me').flush(doctor);
+    expect(authentication.hasSession()).toBe(true);
+  });
+  it('rejects corrupt, expired, and legacy forged storage', () => {
+    sessionStorage.setItem('vitalink-access-token', '{broken');
+    sessionStorage.setItem('vitalink-login-session', JSON.stringify({ userId: 'admin', role: { code: 'doctor' } }));
+    const authentication = store();
+    expect(authentication.hasSession()).toBe(false); expect(tokens.token()).toBeNull();
+    expect(sessionStorage.getItem('vitalink-login-session')).toBeNull();
+  });
+  it('rejects a forged token after server revalidation', () => {
+    const authentication = restored();
+    authentication.ensureValidated().subscribe();
+    requests.expectOne(environment.authApiUrl + '/auth/me').flush({}, { status: 401, statusText: 'Unauthorized' });
+    expect(authentication.hasSession()).toBe(false); expect(tokens.token()).toBeNull();
+  });
+  it('cancels a pending restoration when a new login starts', () => {
+    const authentication = restored();
+    authentication.ensureValidated().subscribe();
+    const previous = requests.expectOne(environment.authApiUrl + '/auth/me');
+    authentication.signIn('family@example.test', 'password').subscribe();
+    expect(previous.cancelled).toBe(true);
+    requests.expectOne(environment.authApiUrl + '/auth/login').flush({ accessToken: 'new', tokenType: 'Bearer', expiresIn: 900,
+      user: { ...doctor, id: 'account-b', role: 'family', careContext: { providerId: null, clinicId: null, familyId: 'caregiver-b' } } });
+    expect(authentication.session()?.userId).toBe('account-b');
+    expect(authentication.careContext().providerId).toBeNull();
+  });
+  it('cancels a pending login on logout and clears profile, context, and selection', () => {
+    const authentication = store();
+    authentication.signIn('doctor@example.test', 'password').subscribe();
+    const pending = requests.expectOne(environment.authApiUrl + '/auth/login');
+    sessionStorage.setItem('vitalink-patient', 'patient-a');
+    authentication.signOut();
+    expect(pending.cancelled).toBe(true); expect(authentication.user()).toBeNull();
+    expect(authentication.careContext().providerId).toBeNull();
+    expect(sessionStorage.getItem('vitalink-patient')).toBeNull();
+  });
+  it('distinguishes bad credentials from temporary failure and rejects unsupported roles', () => {
+    const authentication = store();
+    for (const status of [401, 503]) {
+      authentication.signIn('doctor@example.test', 'password').subscribe({ error: () => {} });
+      requests.expectOne(environment.authApiUrl + '/auth/login').flush({}, { status, statusText: 'Error' });
+      expect(authentication.error()).toBe(status === 401 ? 'invalidCredentials' : 'loginUnavailable');
+    }
+    expect(() => RoleAssembler.toEntity({ code: 'admin' } as never)).toThrow();
+  });
+});
