@@ -0,0 +1,29 @@
+import { inject } from '@angular/core';
+import { HttpErrorResponse, HttpInterceptorFn } from '@angular/common/http';
+import { catchError, throwError } from 'rxjs';
+import { environment } from '../../../environments/environment';
+import { TokenStorage } from './token-storage';
+
+export function isProtectedApiUrl(value: string): boolean {
+  try {
+  const base = new URL(environment.authApiUrl, document.baseURI);
+  const url = new URL(value, document.baseURI);
+  const path = base.pathname.replace(/\/$/, '');
+  return url.origin === base.origin && !url.username && !url.password &&
+    (url.pathname === path || url.pathname.startsWith(path + '/')) &&
+    url.pathname !== path + '/auth/login';
+  } catch { return false; }
+}
+export const authInterceptor: HttpInterceptorFn = (request, next) => {
+  const tokens = inject(TokenStorage);
+  if (!isProtectedApiUrl(request.url)) return next(request);
+  const token = tokens.token();
+  const generation = tokens.generation();
+  return next(token ? request.clone({ setHeaders: { Authorization: 'Bearer ' + token } }) : request).pipe(
+    catchError(error => {
+      if (error instanceof HttpErrorResponse && error.status === 401 && token &&
+          tokens.generation() === generation) tokens.clear();
+      return throwError(() => error);
+    }),
+  );
+};
