+++ b/src/app/iam/infrastructure/token-storage.ts
@@ -0,0 +1,55 @@
+import { Injectable, signal } from '@angular/core';
+import { Subject } from 'rxjs';
+
+@Injectable({ providedIn: 'root' })
+export class TokenStorage {
+  private readonly key = 'vitalink-access-token';
+  private readonly value = signal<{ accessToken: string; expiresAt: number } | null>(null);
+  private timer?: ReturnType<typeof setTimeout>;
+  readonly invalidated = new Subject<void>();
+  readonly generation = signal(0);
+
+  constructor() {
+    try {
+      sessionStorage.removeItem('vitalink-login-session');
+      sessionStorage.removeItem('vitalink-patient');
+      const raw = sessionStorage.getItem(this.key);
+      if (!raw) return;
+      const stored = JSON.parse(raw);
+      if (typeof stored?.accessToken !== 'string' || !stored.accessToken ||
+          !Number.isFinite(stored.expiresAt) || stored.expiresAt <= Date.now() ||
+          stored.expiresAt > Date.now() + 3600000) { this.clear(); return; }
+      this.value.set(stored);
+      this.scheduleExpiry();
+    } catch { this.clear(); }
+  }
+
+  token(): string | null {
+    if (this.value() && this.value()!.expiresAt <= Date.now()) this.clear();
+    return this.value()?.accessToken ?? null;
+  }
+  expiresAt(): number { return this.value()?.expiresAt ?? 0; }
+  save(accessToken: string, expiresIn: number): void {
+    if (!accessToken || !Number.isFinite(expiresIn) || expiresIn < 1 || expiresIn > 3600)
+      throw new Error('loginUnavailable');
+    const value = { accessToken, expiresAt: Date.now() + expiresIn * 1000 };
+    this.value.set(value);
+    try { sessionStorage.setItem(this.key, JSON.stringify(value)); } catch { /* Memory-only session. */ }
+    this.scheduleExpiry();
+  }
+  clear(): void {
+    clearTimeout(this.timer);
+    this.value.set(null);
+    this.generation.update(value => value + 1);
+    try {
+      sessionStorage.removeItem(this.key);
+      sessionStorage.removeItem('vitalink-login-session');
+      sessionStorage.removeItem('vitalink-patient');
+    } catch { /* Storage can be unavailable. */ }
+    this.invalidated.next();
+  }
+  private scheduleExpiry(): void {
+    clearTimeout(this.timer);
+    this.timer = setTimeout(() => this.clear(), Math.max(0, this.expiresAt() - Date.now()));
+  }
+}
